    {
      "id": "porc-001",
      "topicId": "porcentagem",
      "statement": "Uma camiseta custava R$ 80,00. A loja aumentou o preço em 25% e, um mês depois, anunciou um desconto de 20% sobre o novo preço.",
      "prompt": "Qual é o preço final da camiseta?",
      "alternatives": [
        { "id": "A", "text": "R$ 84,00" },
        { "id": "B", "text": "R$ 80,00" },
        { "id": "C", "text": "R$ 76,00" },
        { "id": "D", "text": "R$ 85,00" },
        { "id": "E", "text": "R$ 96,00" }
      ],
      "correctId": "B",
      "difficulty": "media",
      "reasoning": ["80 × 1,25 = 100", "100 × 0,80 = 80"],
      "explanation": "O preço volta a R$ 80,00. Os 20% de desconto incidem sobre R$ 100, uma base maior que a original.",
      "trap": {
        "alternativeId": "A",
        "explanation": "Somar +25% e −20% dá +5%, mas os percentuais se multiplicam: 1,25 × 0,80 = 1."
      },
      "source": { "origin": "soma", "label": "Questão autoral do SOMA", "reviewStatus": "aguardando-revisao" }
    },
